{
  "schema": 1,
  "plugins": [
    {
      "id": "azure-devops",
      "version": "0.3.0",
      "sha256": "fbc881442b64741e4d09a3e9f6d445c67c98fa768af15068550261037511ccd3",
      "url": "https://github.com/Lautimb/mjolnir/releases/download/v0.4.1/azure-devops-0.3.0.mjp",
      "size": 85964,
      "manifest": {
        "id": "azure-devops",
        "version": "0.3.0",
        "engines": {
          "mjolnir": ">=0.3.0",
          "api": 1
        },
        "name": "Azure DevOps",
        "description": "%description%",
        "locales": {
          "es": "locales/es.json",
          "en": "locales/en.json"
        },
        "background": "background.html",
        "contributes": {
          "views": [
            {
              "id": "boards",
              "title": "%boards%",
              "icon": "icons/boards.svg",
              "entry": "boards.html"
            }
          ],
          "providers": [
            {
              "id": "azure-devops",
              "displayName": "Azure DevOps",
              "defaultHost": "dev.azure.com",
              "remotes": [
                {
                  "host": "dev.azure.com",
                  "path": "{org}/{project}/_git/{repo}",
                  "repo": {
                    "owner": "{org}/{project}",
                    "name": "{repo}"
                  }
                },
                {
                  "host": "ssh.dev.azure.com",
                  "path": "v3/{org}/{project}/{repo}",
                  "repo": {
                    "host": "dev.azure.com",
                    "owner": "{org}/{project}",
                    "name": "{repo}"
                  }
                },
                {
                  "host": "{org}.visualstudio.com",
                  "path": "{project}/_git/{repo}",
                  "repo": {
                    "host": "dev.azure.com",
                    "owner": "{org}/{project}",
                    "name": "{repo}"
                  }
                },
                {
                  "host": "{org}.visualstudio.com",
                  "path": "DefaultCollection/{project}/_git/{repo}",
                  "repo": {
                    "host": "dev.azure.com",
                    "owner": "{org}/{project}",
                    "name": "{repo}"
                  }
                },
                {
                  "host": "vs-ssh.visualstudio.com",
                  "path": "v3/{org}/{project}/{repo}",
                  "repo": {
                    "host": "dev.azure.com",
                    "owner": "{org}/{project}",
                    "name": "{repo}"
                  }
                }
              ],
              "auth": {
                "token": true,
                "cli": {
                  "command": "az",
                  "args": [
                    "account",
                    "get-access-token",
                    "--resource",
                    "499b84ac-1321-427f-aa17-267ca6975798",
                    "--query",
                    "accessToken",
                    "-o",
                    "tsv"
                  ]
                }
              },
              "pulls": {
                "refspec": "refs/pull/{number}/merge",
                "features": [
                  "review",
                  "merge",
                  "inlineComments"
                ]
              }
            }
          ]
        },
        "permissions": {
          "network": [
            "https://dev.azure.com",
            "https://app.vssps.visualstudio.com"
          ],
          "workspace": "read"
        }
      },
      "strings": {
        "es": {
          "description": "Cuentas, pull requests y tableros de Azure DevOps. Usá un PAT creado para todas las organizaciones, o la CLI de Azure (az login).",
          "boards": "Boards"
        },
        "en": {
          "description": "Azure DevOps accounts, pull requests and boards. Use a PAT created for all organizations, or the Azure CLI (az login).",
          "boards": "Boards"
        }
      },
      "signature": "uqHO/nPXdbsxSR0mAfSSND3RnsaWmVlubxzT/8JGQB0q7upxY2NFVa3cRtkch3BSjsE0vbmJ6hS792iZhSz4Bw=="
    },
    {
      "id": "http-client",
      "version": "0.1.0",
      "sha256": "93dc178210aa9929196fff3765da486060b05474a5215cc8f931c4663e65a457",
      "url": "https://github.com/Lautimb/mjolnir/releases/download/v0.4.1/http-client-0.1.0.mjp",
      "size": 81200,
      "manifest": {
        "id": "http-client",
        "version": "0.1.0",
        "engines": {
          "mjolnir": ">=0.1.0",
          "api": 1
        },
        "name": "%name%",
        "description": "%description%",
        "locales": {
          "es": "locales/es.json",
          "en": "locales/en.json"
        },
        "contributes": {
          "views": [
            {
              "id": "main",
              "title": "%view%",
              "icon": "icons/http.svg",
              "entry": "index.html"
            }
          ]
        },
        "permissions": {
          "network": [
            "*"
          ],
          "repoFiles": [
            ".mjolnir/http/**"
          ]
        }
      },
      "strings": {
        "es": {
          "name": "Cliente HTTP",
          "description": "Probá APIs desde Mjolnir, con colecciones por repo, entornos e historial.",
          "view": "Cliente HTTP"
        },
        "en": {
          "name": "HTTP client",
          "description": "Try APIs from Mjolnir, with per-repo collections, environments and history.",
          "view": "HTTP client"
        }
      },
      "signature": "OARgPhwIaABgu2I0UH+VRP3M17HK8X1j0a/Ztu5i46p9eQd8U6guO/XWU02jd9ziKCFyBQfZGwE70peaWBJNDg=="
    }
  ]
}
